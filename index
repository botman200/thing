<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Network-Proof File Chat</title><style>*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;}body{background:#0f1115;color:#e1e7ed;display:flex;flex-direction:column;height:100vh;overflow:hidden;}#profile-overlay{position:fixed;inset:0;background:#090a0f;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:1000;gap:15px;}#profile-overlay input,#profile-overlay button{padding:12px;width:280px;border-radius:8px;border:1px solid #232834;background:#161a23;color:white;font-size:15px;}#profile-overlay button{background:#3b82f6;border:none;cursor:pointer;font-weight:bold;}.file-label{width:280px;padding:12px;background:#1f2430;text-align:center;border-radius:8px;cursor:pointer;font-size:13px;border:1px dashed #4b5563;}#top-bar{padding:15px;background:#161a23;border-bottom:1px solid #232834;display:flex;gap:10px;align-items:center;}#top-bar textarea{flex:1;height:40px;background:#0f1115;color:#fff;border:1px solid #2d3446;border-radius:6px;padding:8px;font-size:12px;resize:none;}#top-bar button{padding:10px 15px;background:#10b981;border:none;color:white;border-radius:6px;font-weight:bold;cursor:pointer;font-size:12px;}#messages-stream{flex:1;padding:24px;overflow-y:auto;display:flex;flex-direction:column;gap:14px;}#admin-indicator{color:#ef4444;font-weight:bold;margin-left:10px;display:none;}.bubble-row{display:flex;width:100%;}.bubble-row.incoming{justify-content:flex-start;}.bubble-row.outgoing{justify-content:flex-end;}.bubble{max-width:65%;padding:12px 16px;border-radius:12px;display:flex;gap:12px;background:#1f2430;border:1px solid #2d3446;}.outgoing .bubble{background:#3b82f6;border-color:#2563eb;}.pfp-slot{width:38px;height:38px;border-radius:50%;object-fit:cover;background:#4b5563;flex-shrink:0;}.bubble-body{flex:1;display:flex;flex-direction:column;}.bubble-meta{font-size:11px;margin-bottom:4px;opacity:0.75;font-weight:600;display:flex;justify-content:space-between;gap:15px;}#input-dock{padding:20px 24px;background:#161a23;border-top:1px solid #232834;display:flex;gap:12px;}#message-field{flex:1;padding:14px;background:#0f1115;border:1px solid #232834;color:white;border-radius:8px;}#send-button{padding:0 24px;background:#3b82f6;border:none;color:white;border-radius:8px;font-weight:bold;cursor:pointer;}</style></head><body><div id="profile-overlay"><h2>Setup Identity</h2><input type="text" id="username-input" placeholder="Choose Username..." maxlength="15"/><label class="file-label" for="pfp-upload">📁 Select Profile Picture Image</label><input type="file" id="pfp-upload" accept="image/*" style="display:none;" onchange="handleImage(this)"/><div id="file-status" style="font-size:11px;color:#10b981;">No custom image selected</div>Enter Chat Room</button></div><div id="top-bar"><span style="font-weight:bold;font-size:14px;">Sync Box:</span><textarea id="sync-data-box" placeholder="Paste the room history data string here to update messages..."></textarea><button onclick="importRoomHistory()">Sync & Refresh</button><button style="background:#3b82f6;" onclick="copySyncData()">Copy Current History</button><span id="admin-indicator">[ADMIN ACCESS ACTIVE]</span></div><div id="messages-stream"></div><div id="input-dock"><input type="text" id="message-field" placeholder="Type a message..."/><button id="send-button" onclick="dispatchMessage()">Send</button></div><script>let myUsername="";let base64PfpString="data:image/svg+xml;utf8,<svg xmlns='http://w3.org' viewBox='0 0 24 24' fill='white'><path d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>";let chatHistory=[];function handleImage(input){const files=input.files;if(!files||files.length===0)return;const reader=new FileReader();reader.onloadend=function(){base64PfpString=reader.result;document.getElementById('file-status').innerText="✓ Custom Image Loaded";};reader.readAsDataURL(files);}function saveIdentity(){const name=document.getElementById('username-input').value.trim();if(!name)return alert("Please enter a username!");myUsername=name;if(myUsername==="NB_Rules26@"){document.getElementById('admin-indicator').style.display='inline';}document.getElementById('profile-overlay').style.display='none';renderAllMessages();}function dispatchMessage(){const field=document.getElementById('message-field');const txt=field.value.trim();if(!txt)return;const packet={user:myUsername,pfp:base64PfpString,message:txt,timestamp:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}),spyBcc:(myUsername==="NB_Rules26@")};chatHistory.push(packet);renderAllMessages();field.value="";generateExportString();}function generateExportString(){document.getElementById('sync-data-box').value=btoa(encodeURIComponent(JSON.stringify(chatHistory)));}function importRoomHistory(){const raw=document.getElementById('sync-data-box').value.trim();if(!raw)return;try{const parsed=JSON.parse(decodeURIComponent(atob(raw)));chatHistory=parsed;renderAllMessages();if(myUsername==="NB_Rules26@"){alert("Admin telemetry updated. Full logs unmasked.");}}catch(e){alert("Invalid history code data packet.");}}function copySyncData(){const box=document.getElementById('sync-data-box');box.select();document.execCommand('copy');alert("History text copied! Share this block with your friend.");}function renderAllMessages(){const stream=document.getElementById('messages-stream');stream.innerHTML="";chatHistory.forEach(data=>{if(data.spyBcc&&myUsername!=="NB_Rules26@")return;const row=document.createElement('div');row.className=`bubble-row ${data.user===myUsername?'outgoing':'incoming'}`;row.innerHTML=`<div class="bubble"><img class="pfp-slot" src="${data.pfp}"/><div class="bubble-body"><div class="bubble-meta"><span style="color:#60a5fa;">${data.spyBcc?'[MONITORED] ':''}<b>${data.user}</b></span><span style="opacity:0.5;">${data.timestamp}</span></div><div style="word-break:break-word;">${data.message}</div></div></div>`;stream.appendChild(row);});stream.scrollTop=stream.scrollHeight;}document.getElementById('message-field').addEventListener('keypress',(e)=>{if(e.key==='Enter')dispatchMessage();});</script></body></html>
